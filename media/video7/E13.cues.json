 "cues": [],
 "lines": [
  {
   "id": "bq7_E13_brq0",
   "t": 0.65,
   "end": 4.275,
   "sp": "BRQ",
   "text": "اُنْظُرْ إِلى رَسْمِ ماجِدٍ! تَعالَ نَعْرِفْ حِكايَتَهُ."
  },
  {
   "id": "bq7_E13_n1",
   "t": 5.125,
   "end": 10.84,
   "sp": "HAB",
   "text": "اِسْتَيْقَظَ ماجِدٌ مُبَكِّرًا. لَبِسَ قَميصَهُ، وَسَرَّحَ شَعْرَهُ بِالمُشْطِ."
  },
  {
   "id": "bq7_E13_maj1",
   "t": 11.34,
   "end": 14.025,
   "sp": "MAJ",
   "text": "اليَوْمَ نَزورُ حَديقَةَ الحَيَوانِ!"
  },
  {
   "id": "bq7_E13_n2",
   "t": 14.925,
   "end": 18.335,
   "sp": "HAB",
   "text": "وَضَعَ ماجِدٌ مانْجو وَمَوْزًا في حَقيبَتِهِ."
  },
  {
   "id": "bq7_E13_brq2",
   "t": 18.835,
   "end": 20.625,
   "sp": "BRQ",
   "text": "وَأَنا أَحْمِلُ القَلَمَ!"
  },
  {
   "id": "bq7_E13_n3b",
   "t": 21.525,
   "end": 25.555,
   "sp": "HAB",
   "text": "أَخَذَتِ الجَدَّةُ ماجِدًا وَسَيْفًا إِلى حَديقَةِ الحَيَوانِ."
  },
  {
   "id": "bq7_E13_n_jda3",
   "t": 26.005,
   "end": 30.16,
   "sp": "HAB",
   "text": "قالَتِ الجَدَّةُ: أَمْسِكا يَدي يا وَلَدَيَّ… هَيّا نَدْخُلْ!"
  },
  {
   "id": "bq7_E13_n4",
   "t": 30.91,
   "end": 33.38,
   "sp": "HAB",
   "text": "رَأَوُا النُّمورَ تَلْعَبُ تَحْتَ الشَّجَرَةِ."
  },
  {
   "id": "bq7_E13_say4",
   "t": 33.83,
   "end": 36.255,
   "sp": "SAY",
   "text": "اُنْظُرا! نُمورٌ كَبيرَةٌ!"
  },
  {
   "id": "bq7_E13_n5",
   "t": 37.005,
   "end": 40.375,
   "sp": "HAB",
   "text": "وَعِنْدَ البُحَيْرَةِ، فَتَحَ التِّمْساحُ فَمَهُ."
  },
  {
   "id": "bq7_E13_brq5",
   "t": 40.825,
   "end": 42.83,
   "sp": "BRQ",
   "text": "يا لَهُ مِنْ فَمٍ كَبيرٍ!"
  },
  {
   "id": "bq7_E13_maj5",
   "t": 43.28,
   "end": 46.67,
   "sp": "MAJ",
   "text": "لا تَخَفْ يا بارِقُ! نَحْنُ بَعيدونَ."
  },
  {
   "id": "bq7_E13_n6",
   "t": 47.57,
   "end": 51.385,
   "sp": "HAB",
   "text": "جَلَسوا تَحْتَ الظِّلِّ، وَأَكَلُوا المانْجو وَالمَوْزَ."
  },
  {
   "id": "bq7_E13_n_jda6",
   "t": 51.835,
   "end": 54.65,
   "sp": "HAB",
   "text": "قالَتِ الجَدَّةُ: تَفَضَّلا يا وَلَدَيَّ!"
  },
  {
   "id": "bq7_E13_say6",
   "t": 55.15,
   "end": 56.48,
   "sp": "SAY",
   "text": "المانْجو حُلْوَةٌ!"
  },
  {
   "id": "bq7_E13_n_jda7",
   "t": 57.38,
   "end": 61.605,
   "sp": "HAB",
   "text": "قالَتِ الجَدَّةُ: اِرْبِطا الحِزامَ… سَنَعودُ إِلى البَيْتِ."
  },
  {
   "id": "bq7_E13_n7",
   "t": 62.055,
   "end": 65.125,
   "sp": "HAB",
   "text": "في المَساءِ، ظَهَرَ القَمَرُ في السَّماءِ."
  },
  {
   "id": "bq7_E13_maj7",
   "t": 65.625,
   "end": 67.39,
   "sp": "MAJ",
   "text": "القَمَرُ جَميلٌ!"
  },
  {
   "id": "bq7_E13_n8",
   "t": 68.29,
   "end": 72.095,
   "sp": "HAB",
   "text": "جَلَسَ ماجِدٌ إِلى مَكْتَبِهِ، وَرَسَمَ يَوْمَهُ بِالقَلَمِ."
  },
  {
   "id": "bq7_E13_brq8",
   "t": 72.595,
   "end": 74.44,
   "sp": "BRQ",
   "text": "وَكَتَبْتَ حَرْفَ المِيمِ!"
  },
  {
   "id": "bq7_E13_maj8b",
   "t": 74.89,
   "end": 79.76,
   "sp": "MAJ",
   "text": "حَرْفُ المِيمِ… صَوْتُهُ مَ! وَهُوَ في يَوْمي كُلِّهِ!"
  },
  {
   "id": "bq7_E13_brq9",
   "t": 80.76,
   "end": 83.045,
   "sp": "BRQ",
   "text": "تُصْبِحُ عَلى خَيْرٍ يا ماجِدُ!"
  }
 ],
